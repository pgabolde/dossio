# ─────────────────────────────────────────────────────────────
# Dossio — variables d'environnement
# Copier en .env et renseigner. Ne JAMAIS commiter le .env.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=Dossio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logs ─────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de données (service docker "db") ────────────────────
# Doit correspondre aux identifiants du service "db" du docker-compose.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dossio
DB_USERNAME=dossio
DB_PASSWORD=change-me

# ── Session, cache, queue (tout en base : pas de Redis) ──────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Fichiers, broadcast, mail ────────────────────────────────
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# En local, les mails sont écrits dans storage/logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@dossio.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Service IA (Python / FastAPI, réseau docker interne) ─────
AI_SERVICE_URL=http://ai-service:8000
# Secret partagé Laravel → Python (header). Générer : openssl rand -hex 32
AI_SERVICE_TOKEN=

# ── Fournisseurs LLM / embeddings (utilisés côté Python) ─────
# Fournisseur pas encore choisi (ADR-002). Laisser vide en local :
# les tests mockent tous les appels.
LLM_API_KEY=
EMBEDDINGS_API_KEY=

# ── Front (exposé au navigateur par Vite) ────────────────────
VITE_APP_NAME="${APP_NAME}"
